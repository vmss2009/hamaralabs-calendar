generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  username  String     @unique
  metadata  Json?      @default("{}") // Arbitrary user metadata (e.g., {"isPublic": true})
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  schedules Schedule[]
  Booking   Booking[]
}

model Schedule {
  id        String      @id @default(cuid())
  userId    String
  date      DateTime
  timeSlots TimeSlot[]  // JSON array of time slot objects
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// Individual time slot with customizable availability
model TimeSlot {
  id         String    @id @default(cuid())
  scheduleId String
  startTime  String    // Format: "HH:MM" (e.g., "15:00")
  endTime    String    // Format: "HH:MM" (e.g., "15:15")
  maxSlots   Int       @default(1) // Number of available slots for this time period
  bookedSlots Int      @default(0) // Number of currently booked slots
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  schedule   Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, startTime, endTime])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELED
}

model Booking {
  id         String        @id @default(cuid())
  userId     String // provider who owns the schedule
  date       DateTime // startOfDay for the booked date
  startTime  String // e.g. "15:00"
  endTime    String // e.g. "15:15"
  guestName  String
  guestEmail String
  notes      String?
  status     BookingStatus @default(CONFIRMED)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  Slot   Slot?   @relation(fields: [slotId], references: [id])
  slotId String?

  // Prevent double-booking: multiple bookings allowed for same time if slots available
  @@index([userId, date, startTime, endTime])
}

// A payment/transaction container (named Slot) that can be associated with one or more bookings
model Slot {
  id                    String   @id @default(cuid())
  merchantTransactionId String   @unique
  merchantId            String
  email                 String // can be empty string if unknown
  phone                 String
  amount                Int // stored in smallest currency unit or whole units depending on upstream
  status                String
  items                 Json     @default("[]") // array payload from the upstream, stored as JSON
  paidBy                String?
  paymentMethod         String?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  bookings Booking[]
}
